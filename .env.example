# Local development only. Copy this file to .env and replace every value.
# Spring Boot also reads .env when it is launched from this directory.
MYSQL_ROOT_PASSWORD=replace-with-a-local-mysql-password
DB_URL=jdbc:mysql://localhost:3306/bi_db
DB_USERNAME=root
DB_PASSWORD=replace-with-a-local-mysql-password
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USERNAME=bi
RABBITMQ_PASSWORD=replace-with-a-local-rabbitmq-password
DEEPSEEK_API_KEY=
